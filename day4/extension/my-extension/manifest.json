{
  "manifest_version": 3,
  "name": "my-extension",
  "version": "1.0",
  "description": "Расширение для практики с Playwright",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["https://example.com/*"]
}
